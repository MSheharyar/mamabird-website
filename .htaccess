# Hostinger/Apache. The eBook page was folded into The Book; keep any
# existing advert, email or bookmark pointing at it working.
Redirect 301 /ebook.html /book.html

# Custom not-found page (Netlify picks up 404.html on its own).
ErrorDocument 404 /404.html

# www and non-www were both serving the site with no redirect between them,
# which is two copies of every page as far as a crawler is concerned. The
# canonical tags say non-www, so send www there too.
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# ---- Clean URLs -----------------------------------------------------
# /book serves book.html, and /book.html redirects to /book so there is
# only ever one address for a page as far as a crawler is concerned.
#
# The order matters. The 301 comes first so an old link is corrected in
# the browser, and it is guarded on THE_REQUEST so it only fires for a
# real request and not for the internal rewrite underneath it, which
# would otherwise loop.
#
# WARNING: these rules only work if this host honours .htaccess. That has
# never been verified on this Hostinger account. Internal links are all
# still written as .html on purpose, so if these rules never fire the
# site carries on working exactly as it does today; only the tidy URLs
# are missing. Do not rewrite the internal links to extensionless until
# somebody has loaded https://threebabybirdies.com/book and seen the
# page rather than a 404.
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# The site had no security headers at all beyond upgrade-insecure-requests.
# HSTS is the one that matters most: without it the first request of a
# session can still go out over http before the redirect.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), camera=(), payment=()"
</IfModule>

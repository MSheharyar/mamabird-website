# Hostinger/Apache. Every page is a .php file and is addressed without an
# extension: /book serves book.php, / serves index.php.

DirectoryIndex index.php

# Custom not-found page. ErrorDocument keeps the 404 status.
ErrorDocument 404 /404.php

RewriteEngine On

# www and non-www were both serving the site with no redirect between them,
# which is two copies of every page as far as a crawler is concerned. The
# canonical tags say non-www, so send www there too.
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# The eBook page was folded into The Book; keep any existing advert, email
# or bookmark pointing at it working, whatever extension it carries.
RewriteRule ^ebook(\.html|\.php)?/?$ /book [R=301,L]

# The tools folder and the local dev router are not pages.
RewriteRule ^(tools/|router\.php$) - [R=404,L]

# ---- Clean URLs -----------------------------------------------------
# 1. Old addresses -> extensionless, with a 301 so Google, adverts, emails
#    and bookmarks that still say /book.html (the site's URLs until now)
#    or /book.php are moved over and keep their ranking. The query string
#    is carried across untouched, so reset-password.html?token=... and
#    Stripe's ?session_id=... still arrive.
#
#    Guarded on THE_REQUEST, which is the browser's original request line,
#    so these fire only for an address somebody actually asked for and
#    never for the internal rewrite in step 2, which would otherwise loop.
RewriteCond %{THE_REQUEST} \s/+index(\.html|\.php)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.(html|php)[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

#    /book/ -> /book as well: the pages use relative paths (css/main.css),
#    which would resolve under /book/ and load nothing.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# 2. /book -> book.php, internally. The address bar keeps saying /book.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^([a-z0-9-]+)$ $1.php [L]

# ---- Media types ----------------------------------------------------
# This host serves .webm as text/plain, and a browser will not decode a
# video with that content type. Chirpy fell back to the animated WebP,
# which works but is the lesser asset. The rest are here so the same
# thing cannot happen to the other modern formats.
<IfModule mod_mime.c>
  AddType video/webm                  .webm
  AddType video/mp4                   .mp4
  AddType image/webp                  .webp
  AddType image/avif                  .avif
  AddType image/svg+xml               .svg
  AddType font/woff2                  .woff2
  AddType application/manifest+json   .webmanifest
</IfModule>

# The AddType block above is guarded on mod_mime.c, and this host does not
# report that module, so it is skipped and .webm kept arriving as
# text/plain. mod_headers is demonstrably active here -- the HSTS header
# below is being served -- so the content type is set that way instead.
# The block above stays for a host that does honour it.
<IfModule mod_headers.c>
  <FilesMatch "\.webm$">
    Header set Content-Type "video/webm"
  </FilesMatch>
  <FilesMatch "\.webp$">
    Header set Content-Type "image/webp"
  </FilesMatch>
</IfModule>

# The site had no security headers at all beyond upgrade-insecure-requests.
# HSTS is the one that matters most: without it the first request of a
# session can still go out over http before the redirect.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), camera=(), payment=()"
</IfModule>

# ---- Caching -------------------------------------------------------
# This host serves css and js with max-age=604800, so for a week after a
# deploy a returning visitor carried on running the old file: a fix could
# be live and still invisible to the people asked to look at it.
#
# The pages now reference those files with a hash of their contents in
# the query string (tools/stamp_assets.py writes it), so a changed file
# is a new URL that no cache has, and an unchanged one keeps its stamp
# and stays cached. That only works if the page itself is fresh, hence
# no-cache here -- which means revalidate, not "do not store": the
# browser still keeps its copy and the server answers most of these with
# a 304.
<IfModule mod_headers.c>
  <FilesMatch "\.php$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

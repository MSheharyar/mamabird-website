# Copy to .env.deploy (never committed) and fill in. See docs/DEPLOY.md.
#
# Hostinger web hosting: hPanel > Advanced > SSH Access shows the IP, port (65002) and username (u123456789).
# Hostinger VPS: the server IP, port 22, user root (or the user you created).
SSH_HOST=
SSH_USER=
SSH_PORT=65002
# The private key file on this PC; its .pub half is added in hPanel. Windows example:
SSH_KEY=C:\Users\Dell\.ssh\threebabybirdies_deploy

# The site's folder on the server, relative to the home folder (or absolute).
#   Web hosting: domains/threebabybirdies.com/public_html
#   VPS:         /var/www/threebabybirdies.com (whatever the web server points at)
LIVE_DIR=domains/threebabybirdies.com/public_html
SITE_URL=https://threebabybirdies.com

# Optional test copy, e.g. a staging.threebabybirdies.com subdomain made in hPanel.
STAGING_DIR=
STAGING_URL=

# Optional: extra comma-separated names in the web folder that are not ours and must never be deleted.
KEEP=
